    "test:mouse": "npx electron src/test.js",
    "build:focus": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "start": "electron .",
    "rebuild": "npx electron-rebuild -f -w iohook --version 4.2.12",
    "pack": "npx electron-packager . ChargeBar --platform=win32 --arch=x64 --out=dist --overwrite --electron-version=4.2.12 --ignore=node_modules/iohook/builds/node-v64-win32-x64 --ignore=node_modules/iohook/prebuilds --ignore=.npmrc --ignore=.git --ignore=dist",
