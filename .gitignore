/ChargeBar-win32-x64/resources/*
!/ChargeBar-win32-x64/resources/app/

**/node_modules/
**/dist/
**/*.exe
**/*.dll
**/*.node
**/*.pdb
**/*.log
**/*.tmp
**/settings.json
**/userData/
**/.env
**/.env.*
